<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 Analizador de Contraseñas PRO</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            max-width: 750px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        }
        h1 { text-align: center; color: #2c3e50; margin-bottom: 5px; font-size: 28px; }
        .subtitle { text-align: center; color: #7f8c8d; margin-bottom: 30px; font-size: 14px; }
        .input-group { position: relative; margin-bottom: 25px; }
        input {
            width: 100%;
            padding: 15px 20px;
            font-size: 18px;
            border: 2px solid #ddd;
            border-radius: 12px;
            transition: all 0.3s;
            outline: none;
            font-family: monospace;
            letter-spacing: 1px;
        }
        input:focus { border-color: #3498db; box-shadow: 0 0 0 3px rgba(52,152,219,0.2); }
        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            background: none;
            border: none;
            font-size: 20px;
        }
        .meter-bar {
            width: 100%;
            height: 14px;
            background: #ecf0f1;
            border-radius: 10px;
            overflow: hidden;
            margin: 20px 0 10px;
            position: relative;
        }
        .meter-fill {
            height: 100%;
            width: 0%;
            border-radius: 10px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1), background 0.6s;
        }
        .meter-labels {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #7f8c8d;
            margin-bottom: 20px;
        }
        .result {
            text-align: center;
            padding: 15px;
            border-radius: 12px;
            margin: 20px 0;
            font-weight: 600;
            font-size: 17px;
            transition: all 0.3s;
        }
        .result.debil { background: #fee; color: #c0392b; }
        .result.media { background: #fef9e7; color: #f39c12; }
        .result.fuerte { background: #eafaf1; color: #27ae60; }
        .result.muy-fuerte { background: #e8f8f5; color: #1abc9c; }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            margin: 20px 0;
        }
        .info-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 12px;
            text-align: center;
        }
        .info-card .label { font-size: 11px; color: #7f8c8d; text-transform: uppercase; letter-spacing: 0.5px; }
        .info-card .value { font-size: 18px; font-weight: 700; color: #2c3e50; margin-top: 5px; }
        .info-card .value.time { color: #e74c3c; }
        .history-section { margin-top: 30px; border-top: 2px solid #ecf0f1; padding-top: 20px; }
        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .history-header h3 { color: #2c3e50; font-size: 16px; }
        .history-header button {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 6px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            transition: background 0.3s;
        }
        .history-header button:hover { background: #c0392b; }
        .history-list {
            max-height: 160px;
            overflow-y: auto;
        }
        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            background: #f8f9fa;
            margin-bottom: 5px;
            border-radius: 8px;
            font-size: 13px;
        }
        .history-item .hash {
            font-family: monospace;
            font-size: 11px;
            color: #7f8c8d;
        }
        .strength-badge {
            padding: 2px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        .badge-debil { background: #fee; color: #c0392b; }
        .badge-media { background: #fef9e7; color: #f39c12; }
        .badge-fuerte { background: #eafaf1; color: #27ae60; }
        .badge-muy-fuerte { background: #e8f8f5; color: #1abc9c; }
        .empty-history { text-align: center; color: #bdc3c7; padding: 20px 0; font-size: 14px; }
        @media (max-width: 600px) {
            .container { padding: 20px; }
            .info-grid { grid-template-columns: 1fr; }
            h1 { font-size: 22px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔐 Analizador de Contraseñas</h1>
        <p class="subtitle">Evalúa la seguridad de tu contraseña en tiempo real</p>

        <div class="input-group">
            <input type="password" id="passwordInput" placeholder="Escribe tu contraseña..." oninput="analizar()">
            <button class="toggle-password" onclick="togglePassword()">👁️</button>
        </div>

        <div class="meter-bar">
            <div class="meter-fill" id="meterFill"></div>
        </div>
        <div class="meter-labels">
            <span>Débil</span>
            <span>Media</span>
            <span>Fuerte</span>
            <span>Muy Fuerte</span>
        </div>

        <div class="result" id="resultDisplay">🔄 Esperando contraseña...</div>

        <div class="info-grid">
            <div class="info-card">
                <div class="label">Longitud</div>
                <div class="value" id="lengthDisplay">0</div>
            </div>
            <div class="info-card">
                <div class="label">Complejidad</div>
                <div class="value" id="complexityDisplay">0/5</div>
            </div>
            <div class="info-card">
                <div class="label">Tiempo de cracking</div>
                <div class="value time" id="timeDisplay">-</div>
            </div>
        </div>

        <div class="history-section">
            <div class="history-header">
                <h3>📜 Historial de análisis</h3>
                <button onclick="clearHistory()">🗑️ Limpiar</button>
            </div>
            <div class="history-list" id="historyList">
                <div class="empty-history">No hay análisis guardados</div>
            </div>
        </div>
    </div>

    <script>
        let history = [];
        let isPasswordVisible = false;

        function analizar() {
            const input = document.getElementById('passwordInput');
            const password = input.value;

            if (password.length === 0) {
                resetDisplay();
                return;
            }

            const score = calculateScore(password);
            const level = getLevel(score);
            const color = getColor(level);
            
            updateMeter(score, color);
            updateResult(level, score);
            
            document.getElementById('lengthDisplay').textContent = password.length;
            document.getElementById('complexityDisplay').textContent = score + '/5';
            document.getElementById('timeDisplay').textContent = calculateCrackTime(password);
            
            saveToHistory(password, level);
        }

        function calculateScore(pwd) {
            let score = 0;
            if (pwd.length >= 8) score++;
            if (pwd.length >= 12) score++;
            if (/[a-z]/.test(pwd)) score++;
            if (/[A-Z]/.test(pwd)) score++;
            if (/[0-9]/.test(pwd)) score++;
            if (/[^a-zA-Z0-9]/.test(pwd)) score++;
            
            const commonPatterns = ['123456', 'password', '12345678', 'qwerty', 'abc123'];
            if (commonPatterns.some(pattern => pwd.toLowerCase().includes(pattern))) {
                score = Math.max(0, score - 2);
            }
            return Math.min(5, Math.max(0, score));
        }

        function getLevel(score) {
            if (score <= 1) return { name: 'Débil', emoji: '❌' };
            if (score <= 2) return { name: 'Media', emoji: '⚠️' };
            if (score <= 3) return { name: 'Fuerte', emoji: '✅' };
            return { name: 'Muy Fuerte', emoji: '💪' };
        }

        function getColor(level) {
            const colors = {
                'Débil': '#e74c3c',
                'Media': '#f39c12',
                'Fuerte': '#27ae60',
                'Muy Fuerte': '#1abc9c'
            };
            return colors[level.name] || '#95a5a6';
        }

        function updateMeter(score, color) {
            const fill = document.getElementById('meterFill');
            const percentage = (score / 5) * 100;
            fill.style.width = percentage + '%';
            fill.style.background = color;
        }

        function updateResult(level, score) {
            const display = document.getElementById('resultDisplay');
            const messages = {
                'Débil': '🔴 ¡Muy débil! Fácil de crackear. Mejora con mayúsculas, números y símbolos.',
                'Media': '🟠 Aceptable pero mejorable. Añade más caracteres especiales.',
                'Fuerte': '🟢 Buena contraseña. Segura para la mayoría de usos.',
                'Muy Fuerte': '🟣 ¡Excelente! Nivel militar. Difícil de crackear.'
            };
            display.textContent = `${level.emoji} ${level.name}: ${messages[level.name]}`;
            display.className = `result ${level.name.toLowerCase().replace(' ', '-')}`;
        }

        function calculateCrackTime(pwd) {
            let characterSet = 0;
            if (/[a-z]/.test(pwd)) characterSet += 26;
            if (/[A-Z]/.test(pwd)) characterSet += 26;
            if (/[0-9]/.test(pwd)) characterSet += 10;
            if (/[^a-zA-Z0-9]/.test(pwd)) characterSet += 33;
            
            if (characterSet === 0) return '0 segundos';
            
            const entropy = Math.log2(Math.pow(characterSet, pwd.length));
            const seconds = Math.pow(2, entropy) / 1000000000;
            
            if (seconds < 1) return 'Menos de 1 segundo';
            if (seconds < 60) return `${Math.round(seconds)} segundos`;
            if (seconds < 3600) return `${Math.round(seconds / 60)} minutos`;
            if (seconds < 86400) return `${Math.round(seconds / 3600)} horas`;
            if (seconds < 31536000) return `${Math.round(seconds / 86400)} días`;
            if (seconds < 31536000000) return `${Math.round(seconds / 31536000)} años`;
            return 'Más de 1000 años 🏛️';
        }

        function saveToHistory(password, level) {
            crypto.subtle.digest('SHA-256', new TextEncoder().encode(password))
                .then(hashBuffer => {
                    const hashArray = Array.from(new Uint8Array(hashBuffer));
                    const hashHex = hashArray.slice(0, 6).map(b => b.toString(16).padStart(2, '0')).join('');
                    
                    const exists = history.some(item => item.hash === hashHex);
                    if (exists) return;
                    
                    history.unshift({
                        hash: hashHex,
                        level: level.name,
                        timestamp: new Date().toLocaleTimeString()
                    });
                    
                    if (history.length > 50) history.pop();
                    renderHistory();
                });
        }

        function renderHistory() {
            const list = document.getElementById('historyList');
            if (history.length === 0) {
                list.innerHTML = '<div class="empty-history">No hay análisis guardados</div>';
                return;
            }
            list.innerHTML = history.map(item => `
                <div class="history-item">
                    <span class="hash">#${item.hash} - ${item.timestamp}</span>
                    <span class="strength-badge badge-${item.level.toLowerCase().replace(' ', '-')}">
                        ${item.level}
                    </span>
                </div>
            `).join('');
        }

        function clearHistory() {
            if (confirm('¿Seguro que quieres borrar todo el historial?')) {
                history = [];
                renderHistory();
                localStorage.removeItem('passwordHistory');
            }
        }

        function resetDisplay() {
            document.getElementById('meterFill').style.width = '0%';
            document.getElementById('resultDisplay').textContent = '🔄 Esperando contraseña...';
            document.getElementById('resultDisplay').className = 'result';
            document.getElementById('lengthDisplay').textContent = '0';
            document.getElementById('complexityDisplay').textContent = '0/5';
            document.getElementById('timeDisplay').textContent = '-';
        }

        function togglePassword() {
            const input = document.getElementById('passwordInput');
            isPasswordVisible = !isPasswordVisible;
            input.type = isPasswordVisible ? 'text' : 'password';
            document.querySelector('.toggle-password').textContent = isPasswordVisible ? '🙈' : '👁️';
        }

        window.onload = function() {
            const saved = localStorage.getItem('passwordHistory');
            if (saved) {
                try {
                    history = JSON.parse(saved);
                    renderHistory();
                } catch (e) {
                    history = [];
                }
            }
        };

        setInterval(() => {
            if (history.length > 0) {
                localStorage.setItem('passwordHistory', JSON.stringify(history));
            }
        }, 5000);
    </script>
</body>
</html>
